{
  "name": "vastram",
  "version": "1.0.0",
  "private": true,
  "description": "Vastram full-stack boutique management system for bespoke tailoring.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "check": "npm run build && npm audit --audit-level=moderate",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
